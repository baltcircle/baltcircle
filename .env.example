# Режим работы: production или development. В production включается отдача
# собранного клиента и обязательна установка SESSION_SECRET.
NODE_ENV=production
# Порт HTTP-сервера. По умолчанию 5000.
PORT=5000
# Строка подключения к PostgreSQL (managed Yandex Cloud или локальный сервер).
# REQUIRED в production — пул подключений не поднимется без неё. Формат:
# postgresql://user:password@host:6432/dbname?sslmode=verify-full
# В локальной разработке при пустом значении используется fallback
# postgresql://postgres@127.0.0.1:5433/baltcircle (см. server/db/client.ts).
DATABASE_URL=
# Максимальный размер пула подключений к Postgres. По умолчанию 10.
PG_POOL_MAX=10
# Только для smoke-тестов API: API_ONLY=1 пропускает слой клиента (vite/статику)
# и поднимает только JSON-эндпоинты. В обычной работе оставить пустым.
API_ONLY=
# Пропустить наполнение БД демо-данными при первом старте (используется в
# деплое, где реальная миграция уже отвечает за данные). 1 = пропустить.
SKIP_DEMO_SEED=
# Полностью отключить rate-limit (только для локальной разработки/тестов!).
# 1 = отключить. НИКОГДА не устанавливать в production.
DISABLE_RATE_LIMIT=
# Уровень логирования: error | warn | info | debug. По умолчанию info.
LOG_LEVEL=
# Логировать тело HTTP-ответов (диагностика). 1 = включить. Может писать
# чувствительные данные в лог — не включать постоянно в production.
LOG_RESPONSE_BODY=
# Публичный хост, используемый для построения абсолютных URL тайлов карты,
# когда заголовки прокси (X-Forwarded-Host) отсутствуют. По умолчанию
# takeride.ru.
PUBLIC_HOST=
# Каталог для загруженных файлов (вложения чата поддержки). По умолчанию
# ./uploads относительно рабочей директории процесса.
UPLOADS_DIR=

# Yandex Maps JS API key. Consumed by Vite at build time (import.meta.env).
# Leave empty to fall back to the stylized demo map.
VITE_YANDEX_MAPS_API_KEY=

# --- SMS OTP (backend-only, runtime) ---
# Provider selector. Set to "smsru" or "sigmasms" in production to send real SMS.
# Leave empty for local dev: codes are logged to the server console and echoed
# to the client instead of being sent, so no SMS quota is used.
SMS_PROVIDER=
# SMS.RU account API id (api_id). Required when SMS_PROVIDER=smsru. Keep secret.
SMSRU_API_ID=
# SigmaSMS static account token. Required when SMS_PROVIDER=sigmasms. Keep secret
# (store as the GitHub Actions `SIGMASMS` secret). SIGMASMS_TOKEN is an accepted
# alias and takes precedence if both are set.
SIGMASMS=
SIGMASMS_TOKEN=
# Optional SigmaSMS sender name (the "from" shown to the rider). Must be approved
# in the SigmaSMS cabinet. Defaults to "TakeRide" when empty.
SIGMASMS_SENDER=
# Optional SigmaSMS API base URL. Defaults to https://user.sigmasms.ru/api when
# empty. The "/sendings" path is appended by the app.
SIGMASMS_API_BASE=
# TEMPORARY (SigmaSMS moderation test): overrides the SigmaSMS message text only.
# When empty, SigmaSMS sends a fixed moderation test message that does NOT contain
# the OTP code, so OTP login will not work for the sigmasms provider until this is
# reverted. SMS.RU is unaffected. Set to a text that includes the code to restore.
SIGMASMS_MESSAGE_TEMPLATE=
# Optional dedicated secret used to HMAC OTP codes before storage. Falls back to
# SESSION_SECRET when unset.
OTP_SECRET=
# Session signing secret (also used for OTP hashing fallback). Set a strong
# random value in production.
SESSION_SECRET=
# AES-256-GCM master secret used to encrypt T-Bank RebillId/AccountToken
# (recurring-charge tokens) at rest in payment_methods/payment_orders.
# REQUIRED in production — the app refuses to start encrypting tokens without
# it. Set a strong random value (e.g. `openssl rand -hex 32`) and never rotate
# it without a re-encryption migration (existing ciphertext becomes unreadable).
PAYMENT_TOKEN_KEY=

# --- Onboard bike tracker telemetry ingestion (backend-only, runtime) ---
# Shared bearer token a third-party GPS/IoT tracker presents to POST its position
# to /api/telemetry/bike. The OMNI smart locks do NOT use this path — they speak
# raw TCP, see the block below. When empty, the HTTP ingestion endpoint returns
# 503 ("Telemetry ingestion not configured"). Set a strong random value only if
# something actually needs the HTTP path (store as a GitHub Actions secret).
TELEMETRY_INGEST_TOKEN=

# --- OMNI smart-lock TCP gateway (started with the API) ---
# The locks connect out to us and hold a persistent TCP socket on a dedicated
# port alongside the web API.
#
# Which IP/port/APN a lock dials is flashed on the DEVICE (over BLE on the sample
# units, at the factory for a bulk order) and is therefore not configured here.
# The only thing below that has to match the flashed value is the listen port.
#
# Port to accept lock connections on. Must be reachable from the mobile network
# the locks are on (public IP + firewall/security-group rule), unlike the web app
# which is loopback-only behind nginx.
# Dedicated TCP listener for Omni locks; do not use vendor port 9682.
# Production also requires a matching Docker port publication and inbound
# Yandex Cloud firewall/security-group rule. Those infrastructure changes are
# deliberately manual and outside this repository.
LOCK_GATEWAY_PORT=5100
# Interface to bind. 0.0.0.0 in production; 127.0.0.1 is handy locally when only
# script/omni-sim.ts connects.
LOCK_GATEWAY_HOST=0.0.0.0
# Hard cap on concurrent lock sockets; connections past it are closed at accept.
# A fleet of 100-200 locks needs one socket each, so the default has headroom.
OMNI_MAX_CONNECTIONS=500
# Close a socket that has sent nothing for this long. A lock heartbeats every
# ~4 minutes, so 15 min is about three missed heartbeats.
OMNI_IDLE_TIMEOUT_MS=900000
# Per-source-IP admission control (audit F-05): caps how many NEW connection
# attempts one IP may open within the window below, not concurrent sockets
# (locks can share carrier CGNAT, so many devices legitimately share an IP).
OMNI_MAX_NEW_CONNECTIONS_PER_IP=20
OMNI_NEW_CONNECTION_WINDOW_MS=60000
# Per-connection frame-rate limiter (audit F-06), token bucket: sustained
# refill rate + burst capacity. Real firmware heartbeats every ~4 min and
# position-tracks at most every few seconds, so this has an order of
# magnitude of headroom while still bounding one abusive socket.
OMNI_MAX_FRAMES_PER_SECOND=5
OMNI_FRAME_BUCKET_CAPACITY=20
# Minimum spacing between persisted positionless status rows (check-in,
# heartbeat, no-fix) per bike. Positions and alarms are never throttled.
OMNI_STATUS_MIN_INTERVAL_MS=60000
# Telemetry write batching: flush at least this often, and immediately once this
# many rows are queued.
OMNI_FLUSH_INTERVAL_MS=2000
OMNI_MAX_BATCH_ROWS=500

# --- Admin bootstrap (temporary) ---
# Comma-separated phone numbers that should be granted the admin role. Any
# format works (8…, +7…, spaced) — each is normalized like rider phones. A
# matching phone is promoted to admin on OTP verification and on user lookup.
# Leave empty in local dev: no one is auto-promoted and /admin shows no access.
# Example: ADMIN_PHONE_NUMBERS=+79001234567,+79007654321
ADMIN_PHONE_NUMBERS=

# --- T-Bank / T-Kassa acquiring (backend-only, runtime) ---
# Real card payments via T-Bank classic acquiring. ALL of these are backend-only
# runtime config — never inlined into the client bundle. Keep the terminal key
# and password SECRET (store as GitHub Actions secrets, not in the repo). When
# TBANK_TERMINAL_KEY or TBANK_PASSWORD is empty the payment endpoints return 503
# and the UI shows "Платежи настраиваются" — the app does not crash.
# Terminal key from the T-Bank merchant cabinet.
TBANK_TERMINAL_KEY=
# Terminal password from the T-Bank merchant cabinet. SECRET — used only to sign
# requests/verify notifications (SHA-256 token). Never logged or sent to clients.
# NOTE on a leading/embedded `$`: T-Bank passwords often contain `$`. The signing
# code uses the value verbatim, so a lost `$` is always a DELIVERY problem. When
# this value is loaded by docker compose from a `.env` file, Compose interpolates
# it — escape each `$` as `$$` here (e.g. TBANK_PASSWORD=$$ecret). When exporting
# in the shell before `docker compose` (or via the deploy workflow's host env),
# use the literal value with a single `$`. The admin diagnostics endpoint
# (/api/payments/tbank/diagnostics) reports passwordLength + passwordHasDollar so
# you can confirm the `$` survived without ever exposing the secret.
TBANK_PASSWORD=
# API base for classic acquiring. Defaults to the production host when empty.
# Use the test host for sandbox testing.
TBANK_API_BASE=https://securepay.tinkoff.ru/v2
# Public origin used to build Success/Fail/Notification URLs sent to T-Bank.
# Defaults to https://takeride.ru when empty.
PUBLIC_APP_URL=https://takeride.ru
# AddCard CheckType: NO | HOLD | 3DS | 3DSHOLD. Defaults to 3DS when empty.
# 3DS runs card binding through 3-D Secure (recommended for recurring charges).
# If a test/sandbox terminal rejects 3DS binding, set this to NO to bind without
# the 3-D Secure step for Stage 1 testing. Invalid values fall back to 3DS.
# NOTE: AddCard is now the FALLBACK binding path. The primary path binds a card
# via a small verification payment (Init + Recurrent=Y) — see below.
TBANK_ADD_CARD_CHECK_TYPE=3DS
# Verification-payment amount (in kopecks) for the PRIMARY card-binding path
# (Init + Recurrent=Y). 100 = 1 ₽. The rider pays this tiny amount on T-Bank's
# hosted form; because Recurrent=Y + CustomerKey are set, the acquirer issues a
# RebillId for future ride charges. Empty/invalid/zero/negative falls back to 100.
TBANK_CARD_BIND_AMOUNT_KOPEKS=100
# Способ привязки карты: "payment" (по умолчанию, верификационный платёж +
# Recurrent=Y) или "addcard" (классический AddCard, фолбэк-путь). Любое
# другое/пустое значение трактуется как "payment".
TBANK_CARD_BIND_METHOD=payment

# --- Транзакционная почта (RuSender) ---
# Без обоих значений (API-ключ и key id) сервер не отправляет письма, а
# логирует код/ссылку вместо реальной отправки.
RUSENDER_API_KEY=
RUSENDER_KEY_ID=
# Адрес и имя отправителя. По умолчанию no-reply@takeride.ru / "TakeRide".
EMAIL_FROM=
EMAIL_FROM_NAME=

# --- OAuth: Yandex ID ---
# Оба значения обязательны для включения кнопки "Войти через Яндекс ID";
# при отсутствии эндпоинт возвращает 503.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- OAuth: VK ID ---
# VK_APP_ID обязателен для включения кнопки "Войти через VK ID"; при
# отсутствии эндпоинт возвращает 503.
VK_APP_ID=
# Передаётся в docker-compose/deploy.yml, но на сейчас не считывается
# сервером (авторизация VK ID сейчас без server-to-server валидации подписи).
# Зарезервировано на случай, если проверка подписи будет добавлена.
VK_SECURE_KEY=

# --- Web Push (VAPID) ---
# Пустые — push выключен (endpoints отвечают 503). Сгенерируйте пару
# ключей один раз (например, `npx web-push generate-vapid-keys`) и не меняйте без
# перерегистрации всех активных push-подписок.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact для VAPID-заголовка (mailto: или https:). По умолчанию
# mailto:no-reply@takeride.ru.
VAPID_CONTACT=mailto:no-reply@takeride.ru
